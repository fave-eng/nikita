      "type": "exercise",
      "id": "hw7-ex3",
      "title": "3 Choose the most useful response to each productivity problem.",
      "items": [
        {
          "id": "3-1",
          "number": 1,
          "input": "select",
          "prompt": "You have three large assignments due in the same week and you keep switching between them.",
          "options": [
            "Break each task down and give each stage its own time slot.",
            "Wait until one deadline is looming and work on that task only.",
            "Extend every deadline before you start."
          ],
          "answer": 0
        },
        {
          "id": "3-2",
          "number": 2,
          "input": "select",
          "prompt": "A teammate has gone quiet and their part of the project is due tomorrow.",
          "options": [
            "Check in on their progress and ask whether they need anything.",
            "Ignore it because their task is not your responsibility.",
            "Set out to redo their work without contacting them."
          ],
          "answer": 0
        },
        {
          "id": "3-3",
          "number": 3,
          "input": "select",
          "prompt": "You keep forgetting small final tasks after the main work is finished.",
          "options": [
            "Keep a short list of loose ends and clear it before submission.",
            "Only work when a deadline is looming.",
            "Miss the deadline and explain later."
          ],
          "answer": 0
        },
        {
          "id": "3-4",
          "number": 4,
          "input": "select",
          "prompt": "Meetings and messages constantly interrupt a task that needs concentration.",
          "options": [
            "Block out a protected period for focused work.",
            "Set a new deadline every time somebody messages you.",
            "Dread the deadline until you feel motivated."
          ],
          "answer": 0
        },
        {
          "id": "3-5",
          "number": 5,
          "input": "select",
          "prompt": "A realistic problem means the team genuinely cannot finish by the agreed date.",
          "options": [
            "Discuss extending the deadline before it is missed.",
            "Pretend the deadline does not exist.",
            "Add more loose ends to the project."
          ],
          "answer": 0
        },
        {
          "id": "3-6",
          "number": 6,
          "input": "select",
          "prompt": "You are handling many small tasks and want to remain in control of all of them.",
          "options": [
            "Use one system to stay on top of what is due and what is finished.",
            "Avoid checking your schedule until the end of the week.",
            "Set out to remember everything without writing it down."
          ],
          "answer": 0
        }
      ]
